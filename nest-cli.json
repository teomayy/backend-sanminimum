{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"assets": [
			{
				"include": "src/templates/**/*",
				"outDir": "dist/templates"
			},
			{
				"include": "certificate/fonts/**/*",
				"outDir": "dist"
			}
		],
		"deleteOutDir": true
	}
}
